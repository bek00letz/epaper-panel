{
  "display": "crowpanel_579",
  "rotation": [
    "solar",
    "solar_month",
    "cat",
    "watch",
    "cat",
    "temps",
    "dryer"
  ],
  "pages": {
    "solar": {
      "tier": "rotate",
      "elements": [
        {
          "type": "icon",
          "icon": "mdi:white-balance-sunny",
          "x": 32,
          "y": 44,
          "w": 116,
          "h": 116
        },
        {
          "type": "number",
          "decimals": 1,
          "x": 160,
          "y": 30,
          "w": 310,
          "h": 128,
          "align": "left",
          "entity": "sensor.solar_today_production",
          "show": "state"
        },
        {
          "type": "text",
          "value": "kWh today",
          "size": 30,
          "bold": false,
          "x": 164,
          "y": 170,
          "w": 320,
          "h": 40,
          "align": "left"
        },
        {
          "type": "curve",
          "entity": "sensor.solar_pv_power",
          "hours": 24,
          "x": 490,
          "y": 100,
          "w": 270,
          "h": 86
        }
      ]
    },
    "solar_month": {
      "tier": "rotate",
      "elements": [
        {
          "type": "icon",
          "icon": "mdi:white-balance-sunny",
          "x": 32,
          "y": 44,
          "w": 116,
          "h": 116
        },
        {
          "type": "number",
          "decimals": 0,
          "x": 160,
          "y": 30,
          "w": 310,
          "h": 128,
          "align": "left",
          "entity": "sensor.epaper_solar_month",
          "show": "state"
        },
        {
          "type": "text",
          "value": "kWh this month",
          "size": 30,
          "bold": false,
          "x": 164,
          "y": 170,
          "w": 340,
          "h": 40,
          "align": "left"
        },
        {
          "type": "text",
          "entity": "sensor.home_battery",
          "prefix": "battery ",
          "suffix": " %",
          "size": 30,
          "bold": false,
          "x": 452,
          "y": 170,
          "w": 300,
          "h": 40,
          "align": "right"
        }
      ]
    },
    "cat": {
      "tier": "rotate",
      "elements": [
        {
          "type": "icon",
          "icon": "custom:cat-sitting",
          "x": 96,
          "y": 12,
          "w": 200,
          "h": 200
        },
        {
          "type": "text",
          "entity": "sensor.cat_location",
          "replace": {
            "Outdoor Cat": "outside",
            "Indoor Cat": "inside"
          },
          "x": 320,
          "y": 60,
          "w": 430,
          "h": 112,
          "align": "left"
        },
        {
          "type": "text",
          "entity": "sensor.cat_location",
          "show": "last_changed",
          "format": "time",
          "prefix": "since ",
          "size": 30,
          "bold": false,
          "x": 324,
          "y": 184,
          "w": 420,
          "h": 40,
          "align": "left"
        }
      ]
    },
    "temps": {
      "tier": "rotate",
      "elements": [
        {
          "type": "text",
          "value": "outside",
          "size": 30,
          "bold": false,
          "x": 62,
          "y": 44,
          "w": 200,
          "h": 36
        },
        {
          "type": "number",
          "decimals": 1,
          "x": 56,
          "y": 86,
          "w": 290,
          "h": 112,
          "align": "left",
          "entity": "sensor.outdoor_temperature",
          "show": "state"
        },
        {
          "type": "line",
          "x": 392,
          "y": 40,
          "w": 4,
          "h": 160,
          "thickness": 2
        },
        {
          "type": "text",
          "value": "inside",
          "size": 30,
          "bold": false,
          "x": 436,
          "y": 44,
          "w": 200,
          "h": 36
        },
        {
          "type": "number",
          "decimals": 1,
          "x": 430,
          "y": 86,
          "w": 290,
          "h": 112,
          "align": "left",
          "entity": "sensor.indoor_temperature",
          "show": "state"
        }
      ]
    },
    "watch": {
      "tier": "when",
      "show_if": "{{ states('sensor.epaper_watch_count') | int(0) > 0 }}",
      "elements": [
        {
          "type": "text",
          "value": "new to watch",
          "size": 26,
          "bold": false,
          "x": 40,
          "y": 28,
          "w": 300,
          "h": 36,
          "align": "left"
        },
        {
          "type": "text",
          "entity": "sensor.epaper_watch",
          "show": "attribute",
          "attribute": "detail",
          "size": 26,
          "bold": false,
          "x": 452,
          "y": 28,
          "w": 300,
          "h": 36,
          "align": "right"
        },
        {
          "type": "text",
          "entity": "sensor.epaper_watch",
          "x": 40,
          "y": 74,
          "w": 712,
          "h": 150,
          "align": "left"
        }
      ]
    },
    "dryer": {
      "tier": "when",
      "show_if": "{{ is_state('timer.dryer_cycle','active') }}",
      "elements": [
        {
          "type": "icon",
          "icon": "mdi:tumble-dryer",
          "x": 56,
          "y": 60,
          "w": 110,
          "h": 110
        },
        {
          "type": "text",
          "value": "{{ (state_attr('timer.dryer_cycle','remaining') or '0:00:00')[:-3] }}",
          "x": 190,
          "y": 40,
          "w": 320,
          "h": 122,
          "align": "left"
        },
        {
          "type": "text",
          "value": "dryer, time left",
          "size": 30,
          "bold": false,
          "x": 194,
          "y": 176,
          "w": 400,
          "h": 40,
          "align": "left"
        }
      ]
    },
    "arrival": {
      "tier": "alert",
      "hold_minutes": 15,
      "show_if": "{{ 'zone.extended_home' in (state_attr('person.partner','in_zones') or []) and 'zone.home' not in (state_attr('person.partner','in_zones') or []) }}",
      "elements": [
        {
          "type": "icon",
          "icon": "mdi:map-marker-radius",
          "x": 40,
          "y": 56,
          "w": 120,
          "h": 120
        },
        {
          "type": "text",
          "value": "Arriving",
          "x": 184,
          "y": 34,
          "w": 560,
          "h": 104,
          "align": "left"
        },
        {
          "type": "text",
          "entity": "sensor.partner_distance",
          "prefix": "nearly home · ",
          "suffix": " m away",
          "size": 34,
          "bold": false,
          "x": 188,
          "y": 150,
          "w": 560,
          "h": 44,
          "align": "left"
        }
      ]
    }
  }
}
